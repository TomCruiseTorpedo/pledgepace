# Copy to .env and load with: node --env-file=.env server.mjs
# Leave HELCIM_API_TOKEN empty to run in mock mode (no real Helcim calls).
HELCIM_API_TOKEN=
# Required whenever HELCIM_API_TOKEN is set; the server refuses to start without it.
RELAY_KEY=change-me
# 1 = trust X-Forwarded-For from a proxy or tunnel you run (for the IP sent to Helcim)
TRUST_PROXY=0
PORT=8788
MILESTONE=25
# 1 = charge every pledge automatically when the watch saves the run
AUTO_SETTLE=0
